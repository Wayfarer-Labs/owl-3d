FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    git \
    build-essential \
    cmake \
    ninja-build \
    ffmpeg \
    ca-certificates \
    vim \
    nano \
    htop \
    tmux \
    ssh \
    rsync \
    zip \
    unzip \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install OpenGL and X11 libraries separately to handle potential conflicts
RUN apt-get update && apt-get install -y \
    libgl1 \
    libgl1-mesa-dri \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install additional GUI libraries if needed
RUN apt-get update && apt-get install -y \
    libglu1-mesa \
    libxi6 \
    libxrandr2 \
    libxss1 \
    libxcursor1 \
    libxcomposite1 \
    libxdamage1 \
    libxtst6 \
    libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*

# Install Miniconda
RUN wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p /opt/conda && \
    rm /tmp/miniconda.sh
ENV PATH=/opt/conda/bin:$PATH

# Create conda environment with Python 3.11
RUN conda create -n anycam python=3.11 -y
ENV CONDA_DEFAULT_ENV=anycam
ENV PATH=/opt/conda/envs/anycam/bin:$PATH

# Clone the anycam repository directly into /workspace/anycam
RUN git clone --recursive https://github.com/bmahlbrand/anycam.git /workspace/anycam

# Set working directory
WORKDIR /workspace
 
# Change to anycam directory
WORKDIR /workspace/anycam

# Activate environment and install PyTorch with CUDA 12.4 support
RUN /bin/bash -c "source activate anycam && \
    pip install -r requirements.txt"

# Install additional development dependencies
RUN /bin/bash -c "source activate anycam && \
    pip install ffmpeg-python opencv-python-headless open3d==0.18.0"

# Make download script executable and download pretrained models
RUN chmod +x download_checkpoints.sh && \
    /bin/bash -c "source activate anycam && \
    ./download_checkpoints.sh anycam_seq8"

# Set TORCH_HOME environment variable
ENV TORCH_HOME=/root/.cache/torch

# Create torch hub cache directories and clone repositories
RUN mkdir -p /root/.cache/torch/hub/checkpoints && \
    mkdir -p /root/.cache/torch/hub/bmahlbrand_anycam && \
    mkdir -p /root/.cache/torch/hub/Brummi_UniDepth && \
    mkdir -p /root/.cache/torch/hub/yvanyin_metric3d

# Clone anycam to torch.hub.cache
RUN cd /root/.cache/torch/hub/bmahlbrand_anycam && \
    git clone --recursive 'https://github.com/bmahlbrand/anycam.git' .  && \
    echo "Anycam cache contents:" && \
    ls -la

# Copy local files (these will be mounted in dev container, but included for standalone builds)
COPY test_s3_stream_vis.py  /workspace/anycam/
COPY streaming_anycam_s3.py /workspace/anycam/
COPY anycam_hub_processor.py /workspace/anycam/
COPY ply_exporter.py /workspace/anycam/
COPY open3d_pipeline.py /workspace/anycam/
COPY online_tsdf_pipeline.py /workspace/anycam/
COPY create_side_by_side.py /workspace/anycam/
RUN chmod +x /workspace/anycam/create_side_by_side.py
COPY create_side_by_side.sh /workspace/anycam/
RUN chmod +x /workspace/anycam/create_side_by_side.sh

# Configure Git (useful for development)
RUN git config --global user.name "Developer" && \
    git config --global user.email "dev@example.com" && \
    git config --global init.defaultBranch main

# Create conda activation script for easier development
RUN echo '#!/bin/bash\nsource activate anycam\nexec "$@"' > /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/entrypoint.sh

# Create a convenient alias for activating conda environment
RUN echo 'alias activate-anycam="source activate anycam"' >> /root/.bashrc && \
    echo 'source activate anycam' >> /root/.bashrc

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Default command
CMD ["/bin/bash"]

# Expose port for rerun.io web viewer and jupyter
EXPOSE 9090 8888
